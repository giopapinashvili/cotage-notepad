{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agarakis-rveuli",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "NOTEBOOK", "class_name": "FamilyNotebook" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FamilyNotebook"] }],
  "vars": { "APP_NAME": "აგარაკის ჯავშნები" },
  "observability": { "enabled": false }
}
